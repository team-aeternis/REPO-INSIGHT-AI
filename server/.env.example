PORT=8080
NODE_ENV=production
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/repo-insight
MONGO_DB_NAME=repo-insight
FRONTEND_URL=https://your-client-domain.example
JWT_SECRET=replace_with_a_long_random_secret
LLM_API_KEY=your_groq_api_key
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id

# Optional admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_unique_password_of_at_least_8_characters
ADMIN_NAME=Repo Insight Admin
